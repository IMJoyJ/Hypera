[Ll]ogs/
artifacts/

# Visual Studio / Rider / VS Code cache/options directory
.vs/
.idea/
.vscode/

# MSTest / xUnit test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
