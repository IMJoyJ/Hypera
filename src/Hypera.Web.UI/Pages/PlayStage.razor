    private static string BuildTextClass(string baseClass, StageRenderItem item) =>
        item.SamplingMode == PixelSamplingMode.CrispNearestNeighbor
            ? $"{baseClass} hypera-font-crisp"
            : baseClass;

    private static string BuildTextStyle(StageRenderItem item)
    {
        var sb = new StringBuilder(128);
        sb.Append("left:").Append(item.X.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("top:").Append(item.Y.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("font-size:").Append(item.FontSize).Append("px;");
        sb.Append("color:").Append(FormatHelpers.FormatRgbaCss(item.ColorRgba)).Append(';');

        string font = string.IsNullOrWhiteSpace(item.FontFamily)
            ? "monospace"
            : $"'{item.FontFamily.Replace("'", "\\'")}', monospace";
        sb.Append("font-family:").Append(font).Append(';');

        if ((item.FontStyle & FontStyleFlags.Bold) != 0)
        {
            sb.Append("font-weight:700;");
        }

        if ((item.FontStyle & FontStyleFlags.Italic) != 0)
        {
            sb.Append("font-style:italic;");
        }

        bool underline = (item.FontStyle & FontStyleFlags.Underline) != 0;
        bool strike = (item.FontStyle & FontStyleFlags.Strikeout) != 0;
        if (underline || strike)
        {
            sb.Append("text-decoration:");
            if (underline)
            {
                sb.Append("underline");
            }

            if (underline && strike)
            {
                sb.Append(' ');
            }

            if (strike)
            {
                sb.Append("line-through");
            }

            sb.Append(';');
        }

        return sb.ToString();
    }

    private static string BuildImageClass(StageRenderItem item)
    {
        string samplingClass = item.SamplingMode == PixelSamplingMode.CrispNearestNeighbor
            ? "hypera-img-crisp"
            : "hypera-img-smooth";
        return item.IsInteractiveImage
            ? $"hypera-op hypera-op-image hypera-op-image-interactive {samplingClass}"
            : $"hypera-op hypera-op-image {samplingClass}";
    }

    private static string BuildImageStyle(StageRenderItem item, AssetCacheEntry asset, LogicalViewport vp)
    {
        float w = item.Width > 0f ? item.Width : Math.Max(1, asset.Width);
        float h = item.Height > 0f ? item.Height : Math.Max(1, asset.Height);
        float top = item.IsBottomLeftCbg ? (item.Y + vp.LogicalHeight - h) : item.Y;

        var sb = new StringBuilder(128);
        sb.Append("left:").Append(item.X.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("top:").Append(top.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("width:").Append(w.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("height:").Append(h.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");

        if (item.Opacity < 0.999f)
        {
            sb.Append("opacity:").Append(Math.Clamp(item.Opacity, 0f, 1f).ToString("0.###", CultureInfo.InvariantCulture)).Append(';');
        }

        if (item.FlipX || item.FlipY)
        {
            sb.Append("transform:scale(")
              .Append(item.FlipX ? "-1" : "1")
              .Append(',')
              .Append(item.FlipY ? "-1" : "1")
              .Append(");");
        }

        return sb.ToString();
    }

    private static string BuildShapeStyle(StageRenderItem item) =>
        $"left:{item.X.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
        $"top:{item.Y.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
        $"width:{Math.Max(0f, item.Width).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
        $"height:{Math.Max(0f, item.Height).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
        $"background-color:{FormatHelpers.FormatRgbaCss(item.ColorRgba)};";

    private static string BuildDivStyle(StageRenderItem item)
    {
        var sb = new StringBuilder(192);
        sb.Append("left:").Append(item.X.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("top:").Append(item.Y.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("width:").Append(Math.Max(0f, item.Width).ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
        sb.Append("height:").Append(Math.Max(0f, item.Height).ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");

        if (item.DivStyle is { } div)
        {
            if (div.BackgroundColorRgba.HasValue)
            {
                sb.Append("background-color:").Append(FormatHelpers.FormatRgbaCss(div.BackgroundColorRgba.Value)).Append(';');
            }

            if (!div.Border.IsZero)
            {
                sb.Append("border-style:solid;");
                sb.Append("border-width:")
                  .Append(div.Border.Top.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Border.Right.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Border.Bottom.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Border.Left.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");

                if (div.BorderColors is { } bc)
                {
                    sb.Append("border-top-color:").Append(FormatHelpers.FormatRgbaCss(bc.TopRgba)).Append(';');
                    sb.Append("border-right-color:").Append(FormatHelpers.FormatRgbaCss(bc.RightRgba)).Append(';');
                    sb.Append("border-bottom-color:").Append(FormatHelpers.FormatRgbaCss(bc.BottomRgba)).Append(';');
                    sb.Append("border-left-color:").Append(FormatHelpers.FormatRgbaCss(bc.LeftRgba)).Append(';');
                }
            }

            if (!div.Radius.IsZero)
            {
                sb.Append("border-radius:")
                  .Append(div.Radius.Top.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Radius.Right.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Radius.Bottom.ToString("0.##", CultureInfo.InvariantCulture)).Append("px ")
                  .Append(div.Radius.Left.ToString("0.##", CultureInfo.InvariantCulture)).Append("px;");
            }
        }

        return sb.ToString();
    }

    private void OnUiChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Ui.Changed -= OnUiChanged;
        HostWindow.FullscreenChanged -= OnHostFullscreenChanged;
        CancelTimeout();
        CancelYieldPump();
        StopAnimationLoop();

        if (Ui.IsFullscreen || HostWindow.IsFullscreen)
        {
            try
            {
                await HostWindow.SetFullscreenAsync(false);
            }
            catch
            {
                // Ignore window teardown errors
            }
        }

        Ui.SetFullscreen(false);
        Ui.SetPlayStageActive(false);

        await TryJsVoidAsync("hyperaPlayer.unregisterPlayKeyAndFullscreenHooks");
        await TryJsVoidAsync("hyperaPlayer.detachStageScaler", _wrapperRef);
        await TryJsVoidAsync("hyperaPlayer.stopAllAudio");
        await TryJsVoidAsync("hyperaPlayer.revokeAllAssets");

        _selfRef?.Dispose();
        _selfRef = null;
    }

