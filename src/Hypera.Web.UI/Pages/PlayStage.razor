@page "/play/{AppId:guid}"
@using System.Diagnostics
@using System.Globalization
@using System.Text
@implements IAsyncDisposable
@inject UiSessionState Ui
@inject IAppCatalogService CatalogService
@inject IRuntimeSessionManager SessionManager
@inject IHostWindowService HostWindow
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject NavigationManager Navigation

<div class="@(Ui.IsFullscreen ? "hypera-play-shell hypera-play-shell-fullscreen" : "hypera-play-shell")">
    @* Compact Single-Row Top Bar (hidden in fullscreen; replaced by translucent corner overlay) *@
    @if (!Ui.IsFullscreen)
    {
        <div class="hypera-play-topbar">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Size="Size.Small"
                           title="@Ui.T("player.backToApp")"
                           Href="@($"/apps/{AppId}")" />

            <span class="hypera-play-title" title="@(_app?.Title ?? "Hypera")">
                @(_app?.Title ?? "Hypera")
            </span>

            @if (_playableVersions.Count > 0)
            {
                bool hasMultipleBuilds = _playableVersions.Count > 1 || ActiveVersionLanguages.Count() > 1;
                if (hasMultipleBuilds)
                {
                    <MudMenu Dense="true"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                       Class="text-none px-2"
                                       Style="height: 28px; min-width: 0; font-size: 0.78rem;">
                                @ActiveBuildLabel
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            @foreach (GameVersion ver in _playableVersions)
                            {
                                foreach (string lang in GetPlayableLanguagesFor(ver))
                                {
                                    bool isCurrent = ver.Id == _activeVersionId
                                        && string.Equals(lang, _activeLanguageCode, StringComparison.OrdinalIgnoreCase);
                                    <MudMenuItem OnClick="@(() => SwitchBuildAsync(ver.Id, lang))">
                                        <div class="d-flex align-center justify-space-between gap-3" style="min-width: 150px;">
                                            <MudText Typo="Typo.body2" Style="@(isCurrent ? "font-weight: 600;" : "")">
                                                @ver.VersionLabel · @lang
                                            </MudText>
                                            @if (isCurrent)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                            }
                                        </div>
                                    </MudMenuItem>
                                }
                            }
                        </ChildContent>
                    </MudMenu>
                }
                else if (!string.IsNullOrWhiteSpace(ActiveBuildLabel))
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Secondary"
                             Class="ma-0"
                             Style="height: 24px; font-size: 0.74rem;">
                        @ActiveBuildLabel
                    </MudChip>
                }
            }

            <MudSpacer />

            @if (_renderState is { Summary.MaxUndoSteps: > 0 })
            {
                <MudTooltip Text="@Ui.T("player.undoTooltip", _renderState.Summary.UndoCount.ToString(CultureInfo.InvariantCulture), _renderState.Summary.MaxUndoSteps.ToString(CultureInfo.InvariantCulture))">
                    <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                   Size="Size.Small"
                                   Color="@(_renderState.Summary.CanUndo ? Color.Primary : Color.Default)"
                                   Disabled="@(_busy || !_renderState.Summary.CanUndo)"
                                   OnClick="@UndoSessionAsync" />
                </MudTooltip>
            }

            <MudMenu Dense="true"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudTooltip Text="@Ui.T("settings.audio")">
                        <MudIconButton Icon="@VolumeIcon"
                                       Size="Size.Small"
                                       Color="@(_muted ? Color.Secondary : Color.Default)" />
                    </MudTooltip>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-3 py-2 d-flex align-center gap-2" style="width: 210px;" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@(_muted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                       Size="Size.Small"
                                       Color="@(_muted ? Color.Secondary : Color.Primary)"
                                       title="@(_muted ? Ui.T("player.unmute") : Ui.T("player.mute"))"
                                       OnClick="@ToggleMuteAsync" />
                        <MudSlider T="int"
                                   Value="_masterVolume"
                                   ValueChanged="@OnVolumeChangedAsync"
                                   Min="0"
                                   Max="100"
                                   Size="Size.Small"
                                   Class="flex-grow-1" />
                        <MudText Typo="Typo.caption" Style="min-width: 28px; text-align: right;">@_masterVolume%</MudText>
                    </div>
                </ChildContent>
            </MudMenu>

            <MudTooltip Text="@Ui.T("saves.title")">
                <MudIconButton Icon="@Icons.Material.Filled.Save"
                               Size="Size.Small"
                               OnClick="@(() => _savesDrawerOpen = !_savesDrawerOpen)" />
            </MudTooltip>

            <MudTooltip Text="@Ui.T("app.restart")">
                <MudIconButton Icon="@Icons.Material.Filled.Replay"
                               Size="Size.Small"
                               Disabled="@_busy"
                               OnClick="@RestartSessionAsync" />
            </MudTooltip>

            <MudTooltip Text="@Ui.T("player.fullscreenTooltip")">
                <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                               Size="Size.Small"
                               OnClick="@ToggleFullscreenAsync" />
            </MudTooltip>
        </div>
    }

    @* Optional inline error / fault alert banner (never breaks 100dvh because stage-wrapper flex-shrinks cleanly) *@
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="hypera-play-banner">
            <MudAlert Severity="Severity.Error"
                      Dense="true"
                      ShowCloseIcon="true"
                      CloseIconClicked="@(() => _error = null)">
                @_error
            </MudAlert>
        </div>
    }

    @if (_renderState is not null && !string.IsNullOrWhiteSpace(_renderState.FaultMessage) && !_faultBannerDismissed)
    {
        <div class="hypera-play-banner">
            <MudAlert Severity="@(_renderState.AutoRolledBackOnFault ? Severity.Warning : Severity.Error)"
                      Dense="true"
                      ShowCloseIcon="true"
                      CloseIconClicked="@(() => _faultBannerDismissed = true)">
                <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                    <span>
                        <strong>@Ui.T("player.faulted"):</strong> @_renderState.FaultMessage
                        @if (_renderState.AutoRolledBackOnFault)
                        {
                            <span class="ml-2">(@Ui.T("player.autoRolledBack"))</span>
                        }
                    </span>
                    @if (!_renderState.AutoRolledBackOnFault && _renderState.Summary.CanUndo)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Undo"
                                   Disabled="@_busy"
                                   OnClick="@UndoSessionAsync">
                            @Ui.T("player.undo")
                        </MudButton>
                    }
                </div>
            </MudAlert>
        </div>
    }

    @* Locked LogicalViewport Stage filling exact remaining flex space *@
    <div class="hypera-stage-wrapper" @ref="_wrapperRef">
        @if (Ui.IsFullscreen)
        {
            <div class="hypera-fs-overlay" @onclick:stopPropagation="true">
                @if (_renderState is { Summary.MaxUndoSteps: > 0 })
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   Style="color: #E2E8F0;"
                                   title="@Ui.T("player.undo")"
                                   Disabled="@(_busy || !_renderState.Summary.CanUndo)"
                                   OnClick="@UndoSessionAsync" />
                }

                <MudIconButton Icon="@VolumeIcon"
                               Size="Size.Small"
                               Color="Color.Inherit"
                               Style="color: #E2E8F0;"
                               title="@(_muted ? Ui.T("player.unmute") : Ui.T("player.mute"))"
                               OnClick="@ToggleMuteAsync" />

                <MudIconButton Icon="@Icons.Material.Filled.Save"
                               Size="Size.Small"
                               Color="Color.Inherit"
                               Style="color: #E2E8F0;"
                               title="@Ui.T("saves.title")"
                               OnClick="@(() => _savesDrawerOpen = !_savesDrawerOpen)" />

                <MudIconButton Icon="@Icons.Material.Filled.FullscreenExit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               title="@Ui.T("player.exitFullscreenTooltip")"
                               OnClick="@ToggleFullscreenAsync" />
            </div>
        }

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (_renderState is null)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body1" Color="Color.Secondary">@Ui.T("player.noActiveSession")</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@StartOrAttachSessionAsync">
                    @Ui.T("player.startSession")
                </MudButton>
            </MudStack>
        }
        else
        {
            ConsoleScene scene = _renderState.Scene;
            LogicalViewport vp = scene.Viewport;
            string bgCss = FormatHelpers.FormatRgbaCss(scene.BackgroundColorRgba);

            <div class="hypera-stage-box">
                <div class="hypera-stage"
                     tabindex="0"
                     @ref="_stageRef"
                     style="@($"width:{vp.LogicalWidth}px;height:{vp.LogicalHeight}px;background-color:{bgCss};")"
                     @onclick="@OnStageClickAsync"
                     @onkeydown="@OnStageKeyDownAsync"
                     @onwheel="@OnStageWheelAsync"
                     @onwheel:preventDefault="true">

                    @foreach (StageRenderItem item in _renderItems)
                    {
                        switch (item.Kind)
                        {
                            case StageItemKind.Image:
                            {
                                string? resolvedKey = _hoveredItemKey == item.Key && !string.IsNullOrEmpty(item.HoverAssetKey)
                                    ? item.HoverAssetKey
                                    : item.AssetKey;

                                if (!string.IsNullOrEmpty(resolvedKey) && _assetCache.TryGetValue(resolvedKey, out AssetCacheEntry? asset) && !string.IsNullOrEmpty(asset.BlobUrl))
                                {
                                    string imgClass = BuildImageClass(item);
                                    string imgStyle = BuildImageStyle(item, asset, vp);
                                    <img @key="item.Key"
                                         class="@imgClass"
                                         src="@asset.BlobUrl"
                                         style="@imgStyle"
                                         title="@item.Tooltip"
                                         alt=""
                                         @onmouseenter="@(() => OnItemHover(item, true))"
                                         @onmouseleave="@(() => OnItemHover(item, false))" />
                                }

                                break;
                            }

                            case StageItemKind.Shape:
                                <div @key="item.Key"
                                     class="hypera-op hypera-op-shape"
                                     style="@BuildShapeStyle(item)"></div>
                                break;

                            case StageItemKind.DivBox:
                                <div @key="item.Key"
                                     class="hypera-op hypera-op-div"
                                     style="@BuildDivStyle(item)"></div>
                                break;

                            case StageItemKind.Text:
                                <span @key="item.Key"
                                      class="@BuildTextClass("hypera-op hypera-op-text", item)"
                                      style="@BuildTextStyle(item)">@item.Text</span>
                                break;

                            case StageItemKind.Button:
                                <span @key="item.Key"
                                      class="@BuildTextClass("hypera-op hypera-op-button", item)"
                                      style="@BuildTextStyle(item)"
                                      title="@item.Tooltip"
                                      @onclick="@(e => OnButtonClickAsync(item, e))"
                                      @onclick:stopPropagation="true">@item.Text</span>
                                break;
                        }
                    }
                </div>
            </div>

            @if (_renderState.ScrollOffsetLines > 0)
            {
                <button type="button"
                        class="hypera-scrollback-pill"
                        @onclick="@ScrollToBottomAsync"
                        @onclick:stopPropagation="true">
                    <span>@Ui.T("player.scrollbackLines", _renderState.ScrollOffsetLines.ToString(CultureInfo.InvariantCulture))</span>
                    <strong>@Ui.T("player.scrollToBottom")</strong>
                </button>
            }
        }
    </div>

    @* Dedicated Non-Overlapping Bottom Input Bar *@
    @if (ShouldShowInputBar && _renderState is not null)
    {
        InputRequest? pending = _renderState.PendingInput;
        bool isCompactPrompt = pending is not null
            && pending.Kind is not (InputRequestKind.IntValue or InputRequestKind.StringValue or InputRequestKind.OneInt or InputRequestKind.OneString)
            && _renderState.Summary.EngineStatus != EngineStepStatus.Completed;

        <div class="@(isCompactPrompt ? "hypera-play-inputbar hypera-play-inputbar-compact" : "hypera-play-inputbar")">
            @if (_renderState.Summary.EngineStatus == EngineStepStatus.Completed)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Ui.T("player.completed")</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@RestartSessionAsync">
                    @Ui.T("app.restart")
                </MudButton>
            }
            else if (pending is not null && (pending.Kind == InputRequestKind.IntValue || pending.Kind == InputRequestKind.StringValue))
            {
                <input type="text"
                       class="hypera-play-input"
                       @ref="_inputElRef"
                       value="@_inputText"
                       @oninput="@(e => _inputText = e.Value?.ToString() ?? string.Empty)"
                       @onkeydown="@OnInputFieldKeyDownAsync"
                       placeholder="@Ui.T("player.inputPlaceholder")"
                       disabled="@_busy"
                       autocomplete="off" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@_busy"
                           OnClick="@SubmitTextInputAsync">
                    @Ui.T("player.send")
                </MudButton>
            }
            else if (pending is not null && (pending.Kind == InputRequestKind.OneInt || pending.Kind == InputRequestKind.OneString))
            {
                <input type="text"
                       class="hypera-play-input"
                       style="max-width: 220px;"
                       @ref="_inputElRef"
                       value="@_oneCharText"
                       @oninput="@(e => OnOneCharChangedAsync(e.Value?.ToString() ?? string.Empty))"
                       placeholder="@Ui.T("player.inputPlaceholder")"
                       disabled="@_busy"
                       maxlength="1"
                       autocomplete="off" />
            }
            else if (pending is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(pending.Kind == InputRequestKind.MouseClick ? Ui.T("player.clickToContinue") : Ui.T("player.pressAnyKey"))
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@_busy"
                           OnClick="@ContinuePromptAsync">
                    @Ui.T("player.continue")
                </MudButton>
            }

            @if (_showTimeoutBadge && _remainingSeconds.HasValue)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ma-0">
                    @Ui.T("player.timeoutRemaining", _remainingSeconds.Value.ToString("0.0", CultureInfo.InvariantCulture))
                </MudChip>
            }
        </div>
    }
</div>

@* Slide-over Save Manager Drawer *@
@if (Ui.IsAuthenticated)
{
    <MudDrawer @bind-Open="_savesDrawerOpen"
               Anchor="Anchor.End"
               Variant="DrawerVariant.Temporary"
               Width="440px"
               Elevation="4">
        <div class="pa-4">
            <SaveManagerPanel AppId="@AppId" UserId="@Ui.CurrentUser!.Id" />
        </div>
    </MudDrawer>
}

@code {
    [Parameter]
    public Guid AppId { get; set; }

    [SupplyParameterFromQuery(Name = "versionId")]
    public Guid? QueryVersionId { get; set; }

    [SupplyParameterFromQuery(Name = "lang")]
    public string? QueryLanguageCode { get; set; }

    private GameApp? _app;
    private List<GameVersion> _playableVersions = [];
    private RuntimeSessionRenderState? _renderState;
    private List<StageRenderItem> _renderItems = [];
    private Guid _activeSessionId;
    private Guid _activeVersionId;
    private string _activeLanguageCode = string.Empty;
    private string _inputText = string.Empty;
    private string _oneCharText = string.Empty;
    private string? _error;
    private string? _hoveredItemKey;
    private bool _loading = true;
    private bool _busy;
    private bool _faultBannerDismissed;
    private string? _lastObservedFaultMessage;
    private bool _savesDrawerOpen;
    private bool _muted;
    private int _masterVolume = 100;

    private ElementReference _wrapperRef;
    private ElementReference _stageRef;
    private ElementReference _inputElRef;
    private int _lastScaledW;
    private int _lastScaledH;
    private bool _lastScaledFullscreen;
    private bool _hooksRegistered;
    private DotNetObjectReference<PlayStage>? _selfRef;

    private readonly Dictionary<string, AssetCacheEntry> _assetCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _registeredFontPaths = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _customCrispFonts = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _cachedAudioKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly Stopwatch _animationClock = Stopwatch.StartNew();

    private Guid _audioSyncedSessionId;
    private long _lastAudioEventSeq;

    private CancellationTokenSource? _timeoutCts;
    private long _timeoutGenId = -1;
    private double? _remainingSeconds;
    private bool _showTimeoutBadge;

    private CancellationTokenSource? _animCts;
    private CancellationTokenSource? _yieldCts;
    private bool _disposed;

    private string VolumeIcon =>
        _muted || _masterVolume == 0
            ? Icons.Material.Filled.VolumeOff
            : _masterVolume < 50
                ? Icons.Material.Filled.VolumeDown
                : Icons.Material.Filled.VolumeUp;

    private string ActiveBuildLabel
    {
        get
        {
            GameVersion? ver = _playableVersions.FirstOrDefault(v => v.Id == _activeVersionId);
            if (ver is null)
            {
                return _activeLanguageCode;
            }

            return string.IsNullOrWhiteSpace(_activeLanguageCode)
                ? ver.VersionLabel
                : $"{ver.VersionLabel} · {_activeLanguageCode}";
        }
    }

    private bool ShouldShowInputBar
    {
        get
        {
            if (_renderState is null)
            {
                return false;
            }

            if (_renderState.Summary.EngineStatus == EngineStepStatus.Completed)
            {
                return true;
            }

            InputRequest? pending = _renderState.PendingInput;
            if (pending is null)
            {
                return false;
            }

            if (!Ui.IsFullscreen)
            {
                return true;
            }

            // In fullscreen mode, hide the bottom bar during click/any-key/fade pauses to maximize canvas area.
            return pending.Kind is InputRequestKind.IntValue or InputRequestKind.StringValue or InputRequestKind.OneInt or InputRequestKind.OneString;
        }
    }

    private IEnumerable<string> ActiveVersionLanguages
    {
        get
        {
            GameVersion? ver = _playableVersions.FirstOrDefault(v => v.Id == _activeVersionId);
            return ver is null ? [] : GetPlayableLanguagesFor(ver);
        }
    }

    private static IEnumerable<string> GetPlayableLanguagesFor(GameVersion ver) =>
        ver.Variants
            .Where(static vr => vr.ActiveSubmissionId.HasValue)
            .Select(static vr => vr.LanguageCode)
            .Distinct(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        HostWindow.FullscreenChanged += OnHostFullscreenChanged;
        Ui.SetPlayStageActive(true);
        Ui.SetFullscreen(HostWindow.IsFullscreen);

        await Ui.InitializeAsync();
        if (!Ui.IsAuthenticated)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/play/{AppId}")}");
            return;
        }

        _app = await CatalogService.GetAppDetailAsync(AppId, Ui.CurrentUser!.Id);
        if (_app is not null)
        {
            _playableVersions = _app.Versions
                .OrderByDescending(static v => v.OrderIndex)
                .Where(static v => v.Variants.Any(static vr => vr.ActiveSubmissionId.HasValue))
                .ToList();
        }

        await StartOrAttachSessionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hooksRegistered && !_disposed)
        {
            _hooksRegistered = true;
            _selfRef = DotNetObjectReference.Create(this);
            await TryJsVoidAsync("hyperaPlayer.registerPlayKeyAndFullscreenHooks", _selfRef);
        }

        if (_renderState is null)
        {
            return;
        }

        LogicalViewport vp = _renderState.Scene.Viewport;
        bool isFs = Ui.IsFullscreen;
        if (vp.LogicalWidth != _lastScaledW || vp.LogicalHeight != _lastScaledH || isFs != _lastScaledFullscreen)
        {
            _lastScaledW = vp.LogicalWidth;
            _lastScaledH = vp.LogicalHeight;
            _lastScaledFullscreen = isFs;
            int padPx = isFs ? 0 : 4;
            await TryJsVoidAsync("hyperaPlayer.attachStageScaler", _wrapperRef, _stageRef, vp.LogicalWidth, vp.LogicalHeight, padPx);
        }
    }

    [JSInvokable]
    public void OnDocumentFullscreenChanged(bool isFullscreen)
    {
        if (HostWindow is BrowserHostWindowService browserWindow)
        {
            browserWindow.SyncFromBrowser(isFullscreen);
        }
        else if (Ui.IsFullscreen != isFullscreen && !HostWindow.IsFullscreen)
        {
            Ui.SetFullscreen(isFullscreen);
        }
    }

    [JSInvokable]
    public async Task OnFullscreenShortcutAsync()
    {
        await ToggleFullscreenAsync();
    }

    [JSInvokable]
    public async Task OnEscapeShortcutAsync()
    {
        if (Ui.IsFullscreen)
        {
            await SetFullscreenAsync(false);
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        await SetFullscreenAsync(!Ui.IsFullscreen);
    }

    private async Task SetFullscreenAsync(bool fullscreen)
    {
        bool actual = await HostWindow.SetFullscreenAsync(fullscreen);
        Ui.SetFullscreen(actual);
        _lastScaledW = 0; // force re-measure with updated padding & viewport height
        StateHasChanged();
    }

    private void OnHostFullscreenChanged(bool fullscreen)
    {
        Ui.SetFullscreen(fullscreen);
        _lastScaledW = 0;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task StartOrAttachSessionAsync()
    {
        if (!Ui.IsAuthenticated)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            Guid userId = Ui.CurrentUser!.Id;
            RuntimeSessionSnapshot? snapshot = null;

            if (!QueryVersionId.HasValue && string.IsNullOrWhiteSpace(QueryLanguageCode))
            {
                IReadOnlyList<RuntimeSessionSummary> sessions = await SessionManager.ListUserSessionsAsync(userId);
                RuntimeSessionSummary? match = sessions
                    .Where(s => s.AppId == AppId && s.EngineStatus != EngineStepStatus.Completed && s.EngineStatus != EngineStepStatus.Faulted)
                    .OrderByDescending(static s => s.LastActiveAtUtc)
                    .FirstOrDefault();

                if (match is not null)
                {
                    snapshot = await SessionManager.GetSessionAsync(match.SessionId, userId);
                }
            }

            snapshot ??= await SessionManager.StartSessionAsync(
                userId,
                AppId,
                QueryVersionId,
                QueryLanguageCode);

            await RefreshRenderStateAsync(snapshot.Summary.SessionId, resetIfSessionChanged: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _renderState = null;
            _renderItems = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UndoSessionAsync()
    {
        if (!Ui.IsAuthenticated || _activeSessionId == Guid.Empty || _busy)
        {
            return;
        }

        if (_renderState is not { Summary.CanUndo: true })
        {
            return;
        }

        _busy = true;
        _error = null;
        _faultBannerDismissed = false;
        CancelTimeout();
        CancelYieldPump();
        try
        {
            Guid userId = Ui.CurrentUser!.Id;
            await SessionManager.UndoSessionAsync(_activeSessionId, userId);
            InvalidateDynamicSpriteAndGraphicsCache();
            await RefreshRenderStateAsync(_activeSessionId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void InvalidateDynamicSpriteAndGraphicsCache()
    {
        List<string> staleKeys = [];
        foreach (KeyValuePair<string, AssetCacheEntry> kv in _assetCache)
        {
            if (kv.Value.IsDynamic ||
                kv.Key.StartsWith("g:", StringComparison.OrdinalIgnoreCase) ||
                kv.Key.StartsWith("graphics:", StringComparison.OrdinalIgnoreCase) ||
                kv.Key.StartsWith("sprite:", StringComparison.OrdinalIgnoreCase))
            {
                staleKeys.Add(kv.Key);
            }
        }

        for (int i = 0; i < staleKeys.Count; i++)
        {
            _assetCache.Remove(staleKeys[i]);
        }
    }

    private async Task RestartSessionAsync()
    {
        if (!Ui.IsAuthenticated)
        {
            return;
        }

        _busy = true;
        _error = null;
        CancelTimeout();
        CancelYieldPump();
        StopAnimationLoop();
        try
        {
            Guid userId = Ui.CurrentUser!.Id;
            RuntimeSessionSnapshot snapshot = await SessionManager.RestartSessionAsync(
                userId,
                AppId,
                _activeVersionId == Guid.Empty ? null : _activeVersionId,
                string.IsNullOrWhiteSpace(_activeLanguageCode) ? null : _activeLanguageCode);

            await ResetClientSessionResourcesAsync();
            await RefreshRenderStateAsync(snapshot.Summary.SessionId, resetIfSessionChanged: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SwitchBuildAsync(Guid versionId, string lang)
    {
        if (_activeVersionId == versionId && string.Equals(_activeLanguageCode, lang, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _activeVersionId = versionId;
        _activeLanguageCode = lang;
        await RestartSessionAsync();
    }

    private async Task ResetClientSessionResourcesAsync()
    {
        _assetCache.Clear();
        _cachedAudioKeys.Clear();
        _registeredFontPaths.Clear();
        _customCrispFonts.Clear();
        _audioSyncedSessionId = Guid.Empty;
        _lastAudioEventSeq = 0;
        _hoveredItemKey = null;
        _lastScaledW = 0;
        _lastScaledH = 0;
        _animationClock.Restart();

        await TryJsVoidAsync("hyperaPlayer.stopAllAudio");
        await TryJsVoidAsync("hyperaPlayer.revokeAllAssets");
    }

    private async Task RefreshRenderStateAsync(Guid sessionId, bool resetIfSessionChanged = false)
    {
        if (!Ui.IsAuthenticated || _disposed)
        {
            return;
        }

        Guid userId = Ui.CurrentUser!.Id;
        if (resetIfSessionChanged && _activeSessionId != Guid.Empty && _activeSessionId != sessionId)
        {
            await ResetClientSessionResourcesAsync();
        }

        RuntimeSessionRenderState? state = await SessionManager.GetSessionRenderStateAsync(
            sessionId,
            userId,
            elapsedAnimationMs: _animationClock.ElapsedMilliseconds,
            afterAudioEventSequence: _audioSyncedSessionId == sessionId ? _lastAudioEventSeq : 0);

        if (state is null)
        {
            _renderState = null;
            _renderItems = [];
            return;
        }

        if (state.AutoRolledBackOnFault)
        {
            InvalidateDynamicSpriteAndGraphicsCache();
        }

        if (!string.Equals(_lastObservedFaultMessage, state.FaultMessage, StringComparison.Ordinal))
        {
            _lastObservedFaultMessage = state.FaultMessage;
            _faultBannerDismissed = false;
        }

        _renderState = state;
        _activeSessionId = state.Summary.SessionId;
        _activeVersionId = state.Summary.VersionId;
        _activeLanguageCode = state.Summary.LanguageCode;
        _inputText = string.Empty;
        _oneCharText = string.Empty;
        _hoveredItemKey = null;

        await RegisterCustomFontsAsync(sessionId, userId, state.CustomFonts);

        List<StageRenderItem> items = BuildRenderItems(state.Scene, state.VisibleLineTops);
        await EnsureSceneAssetsLoadedAsync(sessionId, userId, items, state.DynamicAssetVersions);
        _renderItems = items;

        await SyncWebAudioAsync(sessionId, userId, state.Audio);
        ConfigurePendingTimeout(state.PendingInput);
        ConfigureYieldPump(state.Summary.EngineStatus);
        UpdateAnimationLoop();
    }

    private void ConfigureYieldPump(EngineStepStatus status)
    {
        if (status != EngineStepStatus.Yielded || _disposed)
        {
            CancelYieldPump();
            return;
        }

        if (_yieldCts is not null)
        {
            return;
        }

        _yieldCts = new CancellationTokenSource();
        CancellationToken ct = _yieldCts.Token;
        Guid sid = _activeSessionId;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(33, ct);
                await InvokeAsync(async () =>
                {
                    if (_disposed || _busy || _activeSessionId != sid || !Ui.IsAuthenticated)
                    {
                        CancelYieldPump();
                        return;
                    }

                    CancelYieldPump();
                    _busy = true;
                    try
                    {
                        await SessionManager.StepYieldedSessionAsync(sid, Ui.CurrentUser!.Id);
                        await RefreshRenderStateAsync(sid);
                    }
                    catch (Exception ex)
                    {
                        _error = ex.Message;
                    }
                    finally
                    {
                        _busy = false;
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException)
            {
                // Expected on cancel/dispose
            }
        }, ct);
    }

    private void CancelYieldPump()
    {
        if (_yieldCts is not null)
        {
            _yieldCts.Cancel();
            _yieldCts.Dispose();
            _yieldCts = null;
        }
    }

    private async Task RegisterCustomFontsAsync(
        Guid sessionId,
        Guid userId,
        IReadOnlyList<SessionFontDescriptor> customFonts)
    {
        foreach (SessionFontDescriptor font in customFonts)
        {
            if (font.IsCrispTileFont)
            {
                if (!string.IsNullOrWhiteSpace(font.FamilyName))
                {
                    _customCrispFonts.Add(font.FamilyName);
                }

                if (!string.IsNullOrWhiteSpace(font.AliasName))
                {
                    _customCrispFonts.Add(font.AliasName);
                }
            }

            if (!_registeredFontPaths.Add(font.VirtualPath))
            {
                continue;
            }

            try
            {
                SessionAssetPayload? payload = await SessionManager.ReadSessionAssetAsync(sessionId, userId, font.AssetKey);
                if (payload is null || payload.Data.Length == 0)
                {
                    continue;
                }

                var names = new List<string>(2);
                if (!string.IsNullOrWhiteSpace(font.FamilyName))
                {
                    names.Add(font.FamilyName);
                }

                if (!string.IsNullOrWhiteSpace(font.AliasName) &&
                    !names.Contains(font.AliasName, StringComparer.OrdinalIgnoreCase))
                {
                    names.Add(font.AliasName);
                }

                if (names.Count == 0)
                {
                    continue;
                }

                using var ms = new MemoryStream(payload.Data, writable: false);
                using var streamRef = new DotNetStreamReference(ms, leaveOpen: true);
                await Js.InvokeAsync<bool>("hyperaPlayer.registerFontAliasesFromStream", names, streamRef);
            }
            catch
            {
                // Ignore font load errors for non-renderable fonts
            }
        }
    }

    private async Task EnsureSceneAssetsLoadedAsync(
        Guid sessionId,
        Guid userId,
        IReadOnlyList<StageRenderItem> items,
        IReadOnlyDictionary<string, long>? dynamicVersions)
    {
        var keysToLoad = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (StageRenderItem item in items)
        {
            if (item.Kind != StageItemKind.Image)
            {
                continue;
            }

            if (!string.IsNullOrEmpty(item.AssetKey))
            {
                keysToLoad.Add(item.AssetKey);
            }

            if (!string.IsNullOrEmpty(item.HoverAssetKey))
            {
                keysToLoad.Add(item.HoverAssetKey);
            }
        }

        long elapsedMs = _animationClock.ElapsedMilliseconds;
        foreach (string key in keysToLoad)
        {
            bool isDirectGraphics = key.StartsWith("g:", StringComparison.OrdinalIgnoreCase)
                || key.StartsWith("graphics:", StringComparison.OrdinalIgnoreCase);
            long serverVersion = 0;
            bool hasDynamicVer = dynamicVersions is not null && dynamicVersions.TryGetValue(key, out serverVersion);
            bool alreadyCached = _assetCache.TryGetValue(key, out AssetCacheEntry? existing);

            if (alreadyCached && !existing!.IsAnimated)
            {
                if (hasDynamicVer)
                {
                    // Dynamic sprite or graphics surface: only skip fetch if exact content version is unchanged!
                    if (existing.ContentVersion == serverVersion)
                    {
                        continue;
                    }
                }
                else if (!isDirectGraphics && !existing.IsDynamic)
                {
                    // Pure static file-backed sprite
                    continue;
                }
            }

            await FetchAndRegisterAssetAsync(sessionId, userId, key, elapsedMs);
        }
    }

    private async Task FetchAndRegisterAssetAsync(
        Guid sessionId,
        Guid userId,
        string assetKey,
        long elapsedMs)
    {
        try
        {
            SessionAssetPayload? payload = await SessionManager.ReadSessionAssetAsync(sessionId, userId, assetKey, elapsedMs);
            if (payload is null && assetKey.StartsWith("sprite:", StringComparison.OrdinalIgnoreCase))
            {
                string raw = assetKey["sprite:".Length..];
                payload = await SessionManager.ReadSessionAssetAsync(sessionId, userId, raw, elapsedMs);
            }

            if (payload is null || payload.Data.Length == 0)
            {
                return;
            }

            using var ms = new MemoryStream(payload.Data, writable: false);
            using var streamRef = new DotNetStreamReference(ms, leaveOpen: true);
            string? blobUrl = await Js.InvokeAsync<string?>(
                "hyperaPlayer.registerAssetFromStream",
                assetKey,
                payload.MimeType,
                streamRef);

            if (!string.IsNullOrEmpty(blobUrl))
            {
                _assetCache[assetKey] = new AssetCacheEntry(
                    blobUrl,
                    payload.Width,
                    payload.Height,
                    payload.IsAnimated,
                    payload.IsDynamic,
                    payload.ContentVersion);
            }
        }
        catch
        {
            // Ignore transient JS interop or missing asset errors
        }
    }

    private async Task SyncWebAudioAsync(Guid sessionId, Guid userId, WebAudioStateSnapshot audio)
    {
        bool firstSyncForSession = _audioSyncedSessionId != sessionId;
        _audioSyncedSessionId = sessionId;

        if (audio.RecentEvents.Count > 0)
        {
            foreach (WebAudioEvent ev in audio.RecentEvents)
            {
                if (ev.SequenceId <= _lastAudioEventSeq)
                {
                    continue;
                }

                await ApplyAudioEventAsync(sessionId, userId, ev);
            }
        }
        else if (firstSyncForSession)
        {
            if (audio.Bgm.IsPlaying && !string.IsNullOrWhiteSpace(audio.Bgm.VirtualPath))
            {
                string? key = await EnsureAudioAssetCachedAsync(sessionId, userId, audio.Bgm.VirtualPath);
                if (key is not null)
                {
                    await TryJsVoidAsync("hyperaPlayer.playBgmCached", key, audio.Bgm.Volume, audio.Bgm.IsLooping);
                }
            }

            for (int ch = 0; ch < audio.SoundEffects.Count; ch++)
            {
                AudioChannelSnapshot se = audio.SoundEffects[ch];
                if (se.IsPlaying && !string.IsNullOrWhiteSpace(se.VirtualPath))
                {
                    string? key = await EnsureAudioAssetCachedAsync(sessionId, userId, se.VirtualPath);
                    if (key is not null)
                    {
                        await TryJsVoidAsync("hyperaPlayer.playSeCached", ch, key, se.Volume, se.IsLooping);
                    }
                }
            }
        }

        _lastAudioEventSeq = audio.LatestSequenceId;
    }

    private async Task ApplyAudioEventAsync(Guid sessionId, Guid userId, WebAudioEvent ev)
    {
        switch (ev.Kind)
        {
            case WebAudioEventKind.PlayBgm when !string.IsNullOrWhiteSpace(ev.VirtualPath):
            {
                string? key = await EnsureAudioAssetCachedAsync(sessionId, userId, ev.VirtualPath);
                if (key is not null)
                {
                    await TryJsVoidAsync("hyperaPlayer.playBgmCached", key, ev.Volume, ev.IsLooping);
                }

                break;
            }

            case WebAudioEventKind.StopBgm:
                await TryJsVoidAsync("hyperaPlayer.stopBgm");
                break;

            case WebAudioEventKind.SetBgmVolume:
                await TryJsVoidAsync("hyperaPlayer.setBgmVolume", ev.Volume);
                break;

            case WebAudioEventKind.PlaySoundEffect when !string.IsNullOrWhiteSpace(ev.VirtualPath):
            {
                string? key = await EnsureAudioAssetCachedAsync(sessionId, userId, ev.VirtualPath);
                if (key is not null)
                {
                    await TryJsVoidAsync("hyperaPlayer.playSeCached", ev.ChannelIndex, key, ev.Volume, ev.IsLooping);
                }

                break;
            }

            case WebAudioEventKind.StopSoundEffect:
                await TryJsVoidAsync("hyperaPlayer.stopSe", ev.ChannelIndex);
                break;

            case WebAudioEventKind.StopAllSoundEffects:
                await TryJsVoidAsync("hyperaPlayer.stopAllSe");
                break;

            case WebAudioEventKind.SetSoundEffectVolume:
                await TryJsVoidAsync("hyperaPlayer.setSeVolume", ev.ChannelIndex, ev.Volume);
                break;
        }
    }

    private async Task<string?> EnsureAudioAssetCachedAsync(Guid sessionId, Guid userId, string virtualPath)
    {
        string cacheKey = $"audio:{virtualPath}";
        if (_cachedAudioKeys.Contains(cacheKey))
        {
            return cacheKey;
        }

        try
        {
            SessionAssetPayload? payload = await SessionManager.ReadSessionAssetAsync(sessionId, userId, virtualPath);
            if (payload is null || payload.Data.Length == 0)
            {
                return null;
            }

            using var ms = new MemoryStream(payload.Data, writable: false);
            using var streamRef = new DotNetStreamReference(ms, leaveOpen: true);
            string? url = await Js.InvokeAsync<string?>(
                "hyperaPlayer.registerAssetFromStream",
                cacheKey,
                payload.MimeType,
                streamRef);

            if (!string.IsNullOrEmpty(url))
            {
                _cachedAudioKeys.Add(cacheKey);
                return cacheKey;
            }
        }
        catch
        {
            // Ignore audio asset fetch failure
        }

        return null;
    }

    private void UpdateAnimationLoop()
    {
        bool needsAnimation = _assetCache.Values.Any(static a => a.IsAnimated);
        if (!needsAnimation)
        {
            StopAnimationLoop();
            return;
        }

        if (_animCts is not null || _disposed)
        {
            return;
        }

        _animCts = new CancellationTokenSource();
        CancellationToken ct = _animCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
                while (await timer.WaitForNextTickAsync(ct))
                {
                    await InvokeAsync(RefreshAnimatedAssetsAsync);
                }
            }
            catch (OperationCanceledException)
            {
                // Expected on stop/dispose
            }
        }, ct);
    }

    private async Task RefreshAnimatedAssetsAsync()
    {
        if (_disposed || _renderState is null || !Ui.IsAuthenticated)
        {
            return;
        }

        List<string> animatedKeys = _assetCache
            .Where(static kv => kv.Value.IsAnimated)
            .Select(static kv => kv.Key)
            .ToList();

        if (animatedKeys.Count == 0)
        {
            StopAnimationLoop();
            return;
        }

        Guid sid = _renderState.Summary.SessionId;
        Guid uid = Ui.CurrentUser!.Id;
        long elapsedMs = _animationClock.ElapsedMilliseconds;

        foreach (string key in animatedKeys)
        {
            await FetchAndRegisterAssetAsync(sid, uid, key, elapsedMs);
        }

        StateHasChanged();
    }

    private void StopAnimationLoop()
    {
        if (_animCts is not null)
        {
            _animCts.Cancel();
            _animCts.Dispose();
            _animCts = null;
        }
    }

    private List<StageRenderItem> BuildRenderItems(ConsoleScene scene, IReadOnlyList<float> lineTops)
    {
        var items = new List<StageRenderItem>();
        int seq = 0;

        foreach (BackgroundImageLayer bg in scene.BackgroundImages)
        {
            items.Add(new StageRenderItem(
                Key: $"bg_{seq++}",
                Kind: StageItemKind.Image,
                LayerGroup: 0,
                Depth: bg.Depth,
                Order: seq,
                X: 0f,
                Y: 0f,
                Width: scene.Viewport.LogicalWidth,
                Height: scene.Viewport.LogicalHeight,
                AssetKey: NormalizeVisualAssetKey(bg.SpriteName),
                Opacity: bg.Opacity,
                SamplingMode: PixelSamplingMode.SmoothAntialiased));
        }

        foreach (CbgLayer cbg in scene.CbgLayers)
        {
            string? assetKey = !string.IsNullOrWhiteSpace(cbg.SpriteName)
                ? NormalizeVisualAssetKey(cbg.SpriteName)
                : (cbg.GraphicsId.HasValue ? $"g:{cbg.GraphicsId.Value}" : null);

            if (string.IsNullOrEmpty(assetKey))
            {
                continue;
            }

            string? hoverKey = !string.IsNullOrWhiteSpace(cbg.HoverSpriteName)
                ? NormalizeVisualAssetKey(cbg.HoverSpriteName)
                : null;

            items.Add(new StageRenderItem(
                Key: $"cbg_{seq++}",
                Kind: StageItemKind.Image,
                LayerGroup: 1,
                Depth: cbg.Depth,
                Order: seq,
                X: cbg.X,
                Y: cbg.Y,
                Width: 0f,
                Height: 0f,
                IsBottomLeftCbg: true,
                AssetKey: assetKey,
                HoverAssetKey: hoverKey,
                IsInteractiveImage: cbg.IsButton,
                Tooltip: cbg.Tooltip,
                SamplingMode: PixelSamplingMode.CrispNearestNeighbor));
        }

        for (int i = 0; i < scene.VisibleLines.Count; i++)
        {
            float lineTop = i < lineTops.Count ? lineTops[i] : 0f;
            EmitLineItems(items, scene, scene.VisibleLines[i], lineTop, originOffsetX: 0f, layerGroup: 1, ref seq);
        }

        foreach (HtmlIslandLayer island in scene.IslandLayers.OrderByDescending(static l => l.Depth))
        {
            float y = 0f;
            foreach (ConsoleLine line in island.Lines)
            {
                EmitLineItems(items, scene, line, y, originOffsetX: 0f, layerGroup: 2, ref seq, depthOverride: island.Depth);
                y += Math.Max(1, line.LineHeight);
            }
        }

        items.Sort(static (a, b) =>
        {
            int cmp = a.LayerGroup.CompareTo(b.LayerGroup);
            if (cmp != 0)
            {
                return cmp;
            }

            cmp = b.Depth.CompareTo(a.Depth);
            return cmp != 0 ? cmp : a.Order.CompareTo(b.Order);
        });

        return items;
    }

    private void EmitLineItems(
        List<StageRenderItem> items,
        ConsoleScene scene,
        ConsoleLine line,
        float lineTopY,
        float originOffsetX,
        int layerGroup,
        ref int seq,
        int? depthOverride = null)
    {
        foreach (ConsoleRenderPart part in line.Parts)
        {
            int depth = depthOverride ?? part.Depth;
            PixelSamplingMode sampling = part.SamplingMode;
            if (sampling == PixelSamplingMode.Auto &&
                !string.IsNullOrWhiteSpace(part.FontFamily) &&
                _customCrispFonts.Contains(part.FontFamily))
            {
                sampling = PixelSamplingMode.CrispNearestNeighbor;
            }

            switch (part.Kind)
            {
                case ConsolePartKind.Text:
                {
                    if (string.IsNullOrEmpty(part.Text))
                    {
                        break;
                    }

                    bool isActiveButton = part.Button is { IsButton: true } btn && btn.GenerationId == scene.ActiveButtonGeneration;
                    items.Add(new StageRenderItem(
                        Key: $"txt_{seq++}",
                        Kind: isActiveButton ? StageItemKind.Button : StageItemKind.Text,
                        LayerGroup: layerGroup,
                        Depth: depth,
                        Order: seq,
                        X: originOffsetX + part.X,
                        Y: lineTopY + part.YOffset,
                        Width: part.Width,
                        Height: part.Height,
                        Text: part.Text,
                        ColorRgba: part.ColorRgba,
                        FontFamily: part.FontFamily,
                        FontSize: part.FontSize,
                        FontStyle: part.FontStyle,
                        SamplingMode: sampling,
                        Button: isActiveButton ? part.Button : null,
                        Tooltip: part.Button?.Title));
                    break;
                }

                case ConsolePartKind.Image:
                {
                    string? srcKey = NormalizeVisualAssetKey(part.ImageSrc);
                    if (string.IsNullOrEmpty(srcKey))
                    {
                        break;
                    }

                    string? hoverKey = NormalizeVisualAssetKey(part.ImageSrcHover);
                    bool interactive = (part.Button is { IsButton: true } b && b.GenerationId == scene.ActiveButtonGeneration)
                        || !string.IsNullOrWhiteSpace(part.ImageSrcMap);

                    items.Add(new StageRenderItem(
                        Key: $"img_{seq++}",
                        Kind: StageItemKind.Image,
                        LayerGroup: layerGroup,
                        Depth: depth,
                        Order: seq,
                        X: originOffsetX + part.X,
                        Y: lineTopY + part.YOffset,
                        Width: part.Width,
                        Height: part.Height,
                        AssetKey: srcKey,
                        HoverAssetKey: hoverKey,
                        FlipX: part.FlipX,
                        FlipY: part.FlipY,
                        IsInteractiveImage: interactive,
                        SamplingMode: sampling,
                        Button: part.Button,
                        Tooltip: part.Button?.Title));
                    break;
                }

                case ConsolePartKind.RectShape:
                    items.Add(new StageRenderItem(
                        Key: $"shp_{seq++}",
                        Kind: StageItemKind.Shape,
                        LayerGroup: layerGroup,
                        Depth: depth,
                        Order: seq,
                        X: originOffsetX + part.X,
                        Y: lineTopY + part.YOffset,
                        Width: part.Width,
                        Height: part.Height,
                        ColorRgba: part.ColorRgba));
                    break;

                case ConsolePartKind.Div:
                {
                    if (part.Div is null)
                    {
                        break;
                    }

                    LogicalRect outer = ConsoleHitTester.ComputeDivOuterRect(
                        part with { X = part.X + originOffsetX },
                        part.Div,
                        lineTopY,
                        scene.Viewport);

                    int divDepth = depthOverride ?? part.Div.Depth;
                    if ((part.Div.BackgroundColorRgba.HasValue && (part.Div.BackgroundColorRgba.Value & 0xFFu) > 0) ||
                        !part.Div.Border.IsZero)
                    {
                        items.Add(new StageRenderItem(
                            Key: $"div_{seq++}",
                            Kind: StageItemKind.DivBox,
                            LayerGroup: layerGroup,
                            Depth: divDepth,
                            Order: seq,
                            X: outer.X,
                            Y: outer.Y,
                            Width: outer.Width,
                            Height: outer.Height,
                            DivStyle: part.Div));
                    }

                    LogicalRect content = ConsoleHitTester.ComputeDivContentRect(outer, part.Div);
                    float childY = content.Y;
                    foreach (ConsoleLine childLine in part.Div.Children)
                    {
                        EmitLineItems(items, scene, childLine, childY, content.X, layerGroup, ref seq, depthOverride: divDepth);
                        childY += Math.Max(1, childLine.LineHeight);
                    }

                    break;
                }
            }
        }
    }

    private static string? NormalizeVisualAssetKey(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        string trimmed = raw.Trim();
        if (trimmed.StartsWith("sprite:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("g:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("graphics:", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("vfs:", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        return $"sprite:{trimmed}";
    }

    private void OnItemHover(StageRenderItem item, bool entering)
    {
        if (string.IsNullOrEmpty(item.HoverAssetKey))
        {
            return;
        }

        _hoveredItemKey = entering ? item.Key : (_hoveredItemKey == item.Key ? null : _hoveredItemKey);
    }

    private void ConfigurePendingTimeout(InputRequest? pending)
    {
        if (pending is null || !pending.TimeoutMilliseconds.HasValue || pending.TimeoutMilliseconds.Value <= 0)
        {
            CancelTimeout();
            return;
        }

        if (_timeoutGenId == pending.GenerationId && _timeoutCts is not null)
        {
            return;
        }

        CancelTimeout();
        _timeoutGenId = pending.GenerationId;
        long totalMs = pending.TimeoutMilliseconds.Value;
        _remainingSeconds = totalMs / 1000.0;
        _showTimeoutBadge = pending.Kind != InputRequestKind.TimedWait || totalMs >= 1000;
        _timeoutCts = new CancellationTokenSource();
        CancellationToken ct = _timeoutCts.Token;
        long genId = pending.GenerationId;

        _ = Task.Run(async () =>
        {
            var sw = Stopwatch.StartNew();
            int lastDisplayedTenths = (int)Math.Ceiling(totalMs / 100.0);
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
                while (await timer.WaitForNextTickAsync(ct))
                {
                    long leftMs = totalMs - sw.ElapsedMilliseconds;
                    if (leftMs <= 0)
                    {
                        _remainingSeconds = 0;
                        await InvokeAsync(async () =>
                        {
                            await SubmitResponseAsync(new InputResponse(genId, IsTimeout: true));
                        });
                        break;
                    }

                    _remainingSeconds = leftMs / 1000.0;
                    int tenths = (int)Math.Ceiling(leftMs / 100.0);
                    if (_showTimeoutBadge && tenths != lastDisplayedTenths)
                    {
                        lastDisplayedTenths = tenths;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // Cancelled by user input or dispose
            }
        }, ct);
    }

    private void CancelTimeout()
    {
        if (_timeoutCts is not null)
        {
            _timeoutCts.Cancel();
            _timeoutCts.Dispose();
            _timeoutCts = null;
        }

        _timeoutGenId = -1;
        _remainingSeconds = null;
        _showTimeoutBadge = false;
    }

    private async Task SubmitResponseAsync(InputResponse response)
    {
        if (_busy || _renderState is null || !Ui.IsAuthenticated)
        {
            return;
        }

        _busy = true;
        _error = null;
        CancelTimeout();
        CancelYieldPump();
        try
        {
            Guid sid = _renderState.Summary.SessionId;
            await SessionManager.SubmitInputAsync(sid, Ui.CurrentUser!.Id, response);
            await RefreshRenderStateAsync(sid);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ContinuePromptAsync()
    {
        if (_renderState?.PendingInput is not { } pending)
        {
            return;
        }

        await SubmitResponseAsync(new InputResponse(pending.GenerationId, StringValue: string.Empty));
    }

    private async Task OnStageWheelAsync(WheelEventArgs e)
    {
        if (_busy || _renderState is null || !Ui.IsAuthenticated || _renderState.MaxScrollOffsetLines <= 0)
        {
            return;
        }

        int deltaLines = e.DeltaY < 0 ? 3 : -3;
        try
        {
            await SessionManager.ScrollSessionAsync(_renderState.Summary.SessionId, Ui.CurrentUser!.Id, deltaLines);
            await RefreshRenderStateAsync(_renderState.Summary.SessionId);
        }
        catch
        {
            // Ignore scroll failure
        }
    }

    private async Task ScrollToBottomAsync()
    {
        if (_busy || _renderState is null || !Ui.IsAuthenticated)
        {
            return;
        }

        try
        {
            await SessionManager.ScrollSessionAsync(_renderState.Summary.SessionId, Ui.CurrentUser!.Id, 0, scrollToBottom: true);
            await RefreshRenderStateAsync(_renderState.Summary.SessionId);
        }
        catch
        {
            // Ignore scroll failure
        }
    }

    private async Task OnButtonClickAsync(StageRenderItem item, MouseEventArgs e)
    {
        if (_busy || _renderState?.PendingInput is not { } pending || !Ui.IsAuthenticated)
        {
            return;
        }

        LogicalCoordsResult coords = await MapClickCoordsAsync(e);
        if (coords.HasSelection)
        {
            return;
        }

        _busy = true;
        _error = null;
        CancelTimeout();
        CancelYieldPump();
        try
        {
            Guid sid = _renderState.Summary.SessionId;
            Guid uid = Ui.CurrentUser!.Id;
            int mouseBtn = MapMouseButton(e.Button);

            SessionHitTestActionResult hitResult = await SessionManager.HitTestAndClickAsync(
                sid,
                uid,
                coords.X,
                coords.Y,
                mouseBtn,
                submitIfInteractive: true);

            if (!hitResult.InputSubmitted && item.Button is { IsButton: true } btn)
            {
                var fallback = new InputResponse(
                    GenerationId: pending.GenerationId,
                    IsTimeout: false,
                    IntValue: btn.IsInteger ? btn.IntValue : null,
                    StringValue: btn.StringValue ?? (btn.IsInteger ? btn.IntValue.ToString(CultureInfo.InvariantCulture) : item.Text),
                    HitTest: hitResult.HitTestSlots);
                await SessionManager.SubmitInputAsync(sid, uid, fallback);
            }

            await RefreshRenderStateAsync(sid);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnStageClickAsync(MouseEventArgs e)
    {
        if (_busy || _renderState?.PendingInput is null || !Ui.IsAuthenticated)
        {
            return;
        }

        LogicalCoordsResult coords = await MapClickCoordsAsync(e);
        if (coords.HasSelection || !coords.Inside)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            Guid sid = _renderState.Summary.SessionId;
            Guid uid = Ui.CurrentUser!.Id;
            int mouseBtn = MapMouseButton(e.Button);

            SessionHitTestActionResult hitResult = await SessionManager.HitTestAndClickAsync(
                sid,
                uid,
                coords.X,
                coords.Y,
                mouseBtn,
                submitIfInteractive: true);

            if (hitResult.InputSubmitted)
            {
                CancelTimeout();
                CancelYieldPump();
                await RefreshRenderStateAsync(sid);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnStageKeyDownAsync(KeyboardEventArgs e)
    {
        if (!_busy &&
            _renderState is { Summary.CanUndo: true } &&
            ((e.CtrlKey && string.Equals(e.Key, "z", StringComparison.OrdinalIgnoreCase)) ||
             (e.AltKey && string.Equals(e.Key, "ArrowLeft", StringComparison.Ordinal))))
        {
            await UndoSessionAsync();
            return;
        }

        if (_renderState?.PendingInput is not { } pending)
        {
            return;
        }

        if (pending.Kind is InputRequestKind.AnyKey or InputRequestKind.TimedWait)
        {
            if (e.Key is "F11" or "Escape")
            {
                return;
            }

            await SubmitResponseAsync(new InputResponse(pending.GenerationId, StringValue: e.Key));
        }
        else if (pending.Kind == InputRequestKind.OneInt && e.Key.Length == 1 && long.TryParse(e.Key, out long digit))
        {
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, IntValue: digit, StringValue: e.Key));
        }
        else if (pending.Kind == InputRequestKind.OneString && e.Key.Length == 1)
        {
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, StringValue: e.Key));
        }
    }

    private async Task OnInputFieldKeyDownAsync(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.Ordinal))
        {
            await SubmitTextInputAsync();
        }
    }

    private async Task SubmitTextInputAsync()
    {
        if (_renderState?.PendingInput is not { } pending)
        {
            return;
        }

        if (pending.Kind == InputRequestKind.IntValue)
        {
            long? parsed = long.TryParse(_inputText.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out long n)
                ? n
                : null;
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, IntValue: parsed, StringValue: _inputText));
        }
        else
        {
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, StringValue: _inputText));
        }
    }

    private async Task OnOneCharChangedAsync(string value)
    {
        _oneCharText = value;
        if (string.IsNullOrEmpty(value) || _renderState?.PendingInput is not { } pending)
        {
            return;
        }

        string ch = value[..1];
        if (pending.Kind == InputRequestKind.OneInt)
        {
            long? parsed = long.TryParse(ch, NumberStyles.Integer, CultureInfo.InvariantCulture, out long n) ? n : null;
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, IntValue: parsed, StringValue: ch));
        }
        else
        {
            await SubmitResponseAsync(new InputResponse(pending.GenerationId, StringValue: ch));
        }
    }

    private async Task<LogicalCoordsResult> MapClickCoordsAsync(MouseEventArgs e)
    {
        if (_renderState is null)
        {
            return new LogicalCoordsResult(0, 0, false, false);
        }

        LogicalViewport vp = _renderState.Scene.Viewport;
        try
        {
            return await Js.InvokeAsync<LogicalCoordsResult>(
                "hyperaPlayer.getLogicalCoords",
                _stageRef,
                e.ClientX,
                e.ClientY,
                vp.LogicalWidth,
                vp.LogicalHeight);
        }
        catch
        {
            return new LogicalCoordsResult(0, 0, true, false);
        }
    }

    private static int MapMouseButton(long domButton) => domButton switch
    {
        0 => 1,
        2 => 2,
        1 => 4,
        _ => 1,
    };

