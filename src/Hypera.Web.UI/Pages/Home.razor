@page "/"
@implements IDisposable
@inject UiSessionState Ui
@inject IAppCatalogService CatalogService
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="hypera-page-header">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.h5" Style="font-weight: 600;">
            @(Ui.IsLocalSingleUser ? Ui.T("catalog.libraryTitle") : Ui.T("catalog.title"))
        </MudText>
        @if (!_loading && _apps.Count > 0)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                @Ui.T("catalog.gameCount", _apps.Count.ToString())
            </MudChip>
        }
    </div>

    <div class="d-flex flex-wrap align-center gap-2">
        <MudTextField @bind-Value="_search"
                      Placeholder="@Ui.T("app.search")"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Style="min-width: 220px;" />

        @if (Ui.IsAuthenticated)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenCreateDialogAsync">
                @(Ui.IsLocalSingleUser ? Ui.T("catalog.importGame") : Ui.T("catalog.newApp"))
            </MudButton>
        }
        else if (Ui.IsMultiUserServer)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Login"
                       Href="/login">
                @Ui.T("auth.login")
            </MudButton>
        }
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (FilteredApps.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-10 text-center">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Style="max-width: 480px;">
                @(Ui.IsLocalSingleUser && string.IsNullOrWhiteSpace(_search)
                    ? Ui.T("catalog.emptyLocalHint")
                    : Ui.T("catalog.empty"))
            </MudText>
            @if (Ui.IsAuthenticated && string.IsNullOrWhiteSpace(_search))
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OpenCreateDialogAsync">
                    @(Ui.IsLocalSingleUser ? Ui.T("catalog.importGame") : Ui.T("catalog.newApp"))
                </MudButton>
            }
        </MudStack>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (GameApp app in FilteredApps)
        {
            List<string> languages = app.Versions
                .SelectMany(static v => v.Variants)
                .Where(static vr => vr.ActiveSubmissionId.HasValue)
                .Select(static vr => vr.LanguageCode)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            bool playable = languages.Count > 0;
            SubmissionStatus? latestStatus = app.Versions
                .SelectMany(static v => v.Submissions)
                .OrderByDescending(static s => s.CreatedAtUtc)
                .Select(static s => (SubmissionStatus?)s.Status)
                .FirstOrDefault();

            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Class="hypera-app-card">
                    <MudCardHeader Class="pb-1">
                        <CardHeaderContent>
                            <MudLink Href="@($"/apps/{app.Id}")"
                                     Typo="Typo.h6"
                                     Underline="Underline.Hover"
                                     Color="Color.Default"
                                     Class="hypera-ellipsis d-block"
                                     Style="font-weight: 600;">
                                @app.Title
                            </MudLink>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!playable && latestStatus == SubmissionStatus.Compiling)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width:11px;height:11px;" />
                                    @Ui.T("catalog.statusCompiling")
                                </MudChip>
                            }
                            else if (!playable && latestStatus == SubmissionStatus.CompileFailed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                    @Ui.T("catalog.statusFailed")
                                </MudChip>
                            }
                            else if (!Ui.IsLocalSingleUser && !app.IsPublicPool)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                    @Ui.T("catalog.privatePending")
                                </MudChip>
                            }
                            else if (app.Versions.Count > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                    @Ui.T("catalog.versionCount", app.Versions.Count.ToString())
                                </MudChip>
                            }
                            @if (!Ui.IsLocalSingleUser && app.ForkedFromAppId.HasValue)
                            {
                                <MudTooltip Text="@Ui.T("catalog.forkedFrom")">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Secondary" Class="mt-2 mr-1" />
                                </MudTooltip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Class="pt-1 flex-grow-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="hypera-summary-clamp mb-2">
                            @app.Summary
                        </MudText>

                        <div class="d-flex flex-wrap align-center gap-1 mt-1">
                            @if (playable)
                            {
                                @foreach (string lang in languages)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @lang
                                    </MudChip>
                                }
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                    @Ui.T("catalog.noPlayableVersion")
                                </MudChip>
                            }
                        </div>
                    </MudCardContent>

                    <MudDivider />

                    <MudCardActions Class="px-3 py-2 d-flex align-center justify-space-between">
                        <div class="d-flex align-center gap-1">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Disabled="@(!playable || !Ui.IsAuthenticated)"
                                       Href="@($"/play/{app.Id}")">
                                @Ui.T("app.play")
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Href="@($"/apps/{app.Id}")">
                                @Ui.T("catalog.details")
                            </MudButton>
                        </div>

                        @if (Ui.IsAuthenticated)
                        {
                            <MudTooltip Text="@Ui.T("saves.title")">
                                <MudIconButton Icon="@Icons.Material.Filled.Save"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               Href="@($"/apps/{app.Id}/saves")" />
                            </MudTooltip>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<GameApp> _apps = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private CancellationTokenSource? _pollCts;

    private IReadOnlyList<GameApp> FilteredApps
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
            {
                return _apps;
            }

            string q = _search.Trim();
            return _apps.Where(a =>
                a.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                || a.Summary.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        await Ui.InitializeAsync();
        await LoadAppsAsync();
    }

    private async Task LoadAppsAsync()
    {
        try
        {
            IReadOnlyList<GameApp> list = await CatalogService.ListVisibleAppsAsync(Ui.CurrentUser?.Id);
            _apps = list.ToList();

            bool anyCompiling = _apps.Any(static a =>
                a.Versions.Any(static v => v.Submissions.Any(static s => s.Status == SubmissionStatus.Compiling)));
            if (anyCompiling)
            {
                StartPolling();
            }
            else
            {
                StopPolling();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        if (!Ui.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var parameters = new DialogParameters<CreateAppDialog>
        {
            { x => x.UserId, Ui.CurrentUser!.Id },
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
        };

        string title = Ui.IsLocalSingleUser ? Ui.T("catalog.importGame") : Ui.T("catalog.newApp");
        IDialogReference dialog = await DialogService.ShowAsync<CreateAppDialog>(title, parameters, options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: Guid createdAppId })
        {
            Navigation.NavigateTo($"/apps/{createdAppId}");
        }
    }

    private void StartPolling()
    {
        if (_pollCts is not null)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        CancellationToken token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2.5));
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAppsAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Expected on dispose or completion
            }
        }, token);
    }

    private void StopPolling()
    {
        if (_pollCts is null)
        {
            return;
        }

        _pollCts.Cancel();
        _pollCts.Dispose();
        _pollCts = null;
    }

    private void OnUiChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StopPolling();
        Ui.Changed -= OnUiChanged;
    }
}
