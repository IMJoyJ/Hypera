@page "/settings"
@implements IDisposable
@inject UiSessionState Ui
@inject IAuthService AuthService
@inject PlatformHostOptions HostOptions
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<MudContainer MaxWidth="MaxWidth.Medium" Class="px-0">
    <div class="hypera-page-header">
        <MudText Typo="Typo.h5" Style="font-weight: 600;">@Ui.T("settings.title")</MudText>
    </div>

    <MudStack Spacing="4">
        @* 1. Appearance, Language & Version Resolution *@
        <MudPaper Outlined="true" Class="hypera-section-card">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-3">
                @Ui.T("settings.sectionGeneral")
            </MudText>

            <MudGrid Spacing="3" Class="align-center mb-3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Value="_uiLanguage"
                               ValueChanged="@OnUiLanguageSelectedAsync"
                               Label="@Ui.T("settings.uiLanguage")"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (LocaleInfo locale in Ui.AvailableLocales)
                        {
                            <MudSelectItem Value="@locale.Code">@locale.NativeName (@locale.Code)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool"
                               Value="Ui.IsDarkMode"
                               ValueChanged="@OnDarkModeChangedAsync"
                               Color="Color.Primary"
                               Label="@Ui.T("settings.darkMode")" />
                </MudItem>
            </MudGrid>

            @if (Ui.IsAuthenticated)
            {
                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@Ui.T("settings.knownLanguages")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    @Ui.T("settings.knownLanguagesHint")
                </MudText>

                <MudStack Spacing="2" Class="mb-3">
                    @for (int i = 0; i < _knownLanguages.Count; i++)
                    {
                        int index = i;
                        string lang = _knownLanguages[index];
                        <MudPaper Outlined="true" Class="px-3 py-2 d-flex align-center justify-space-between gap-2">
                            <div class="d-flex align-center gap-2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                    @(index + 1)
                                </MudChip>
                                <MudText Typo="Typo.body2">@FormatHelpers.GetLanguageLabel(lang, Ui.Localizer)</MudText>
                            </div>
                            <div class="d-flex align-center gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               Disabled="@(index == 0)"
                                               OnClick="@(() => MoveLanguage(index, index - 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                               Size="Size.Small"
                                               Disabled="@(index == _knownLanguages.Count - 1)"
                                               OnClick="@(() => MoveLanguage(index, index + 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="@(_knownLanguages.Count <= 1)"
                                               OnClick="@(() => RemoveLanguage(index))" />
                            </div>
                        </MudPaper>
                    }
                </MudStack>

                @if (AddableLanguages.Count > 0)
                {
                    <div class="d-flex flex-wrap align-center gap-2 mb-4">
                        <MudSelect T="string"
                                   @bind-Value="_langToAdd"
                                   Label="@Ui.T("settings.addLanguage")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Style="max-width: 260px;">
                            @foreach (string lang in AddableLanguages)
                            {
                                <MudSelectItem Value="@lang">@FormatHelpers.GetLanguageLabel(lang, Ui.Localizer)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="@string.IsNullOrWhiteSpace(_langToAdd)"
                                   OnClick="@AddLanguage">
                            @Ui.T("settings.addLanguage")
                        </MudButton>
                    </div>
                }

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                    @Ui.T("settings.versionStrategy")
                </MudText>

                <MudRadioGroup T="VersionResolutionStrategy" @bind-Value="_strategy">
                    <MudStack Spacing="2">
                        <div>
                            <MudRadio Value="VersionResolutionStrategy.KnownLanguagePriority" Color="Color.Primary">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@Ui.T("settings.strategyKnownLang")</MudText>
                            </MudRadio>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-8 d-block">
                                @Ui.T("settings.strategyKnownLangDesc")
                            </MudText>
                        </div>

                        <div>
                            <MudRadio Value="VersionResolutionStrategy.VersionPriority" Color="Color.Primary">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@Ui.T("settings.strategyVersion")</MudText>
                            </MudRadio>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-8 d-block">
                                @Ui.T("settings.strategyVersionDesc")
                            </MudText>
                        </div>

                        <div>
                            <MudRadio Value="VersionResolutionStrategy.AlwaysLastRun" Color="Color.Primary">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@Ui.T("settings.strategyLastRun")</MudText>
                            </MudRadio>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-8 d-block">
                                @Ui.T("settings.strategyLastRunDesc")
                            </MudText>
                        </div>
                    </MudStack>
                </MudRadioGroup>

                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@_savingPrefs"
                               OnClick="@SavePreferencesAsync">
                        @Ui.T("app.save")
                    </MudButton>
                </div>
            }
        </MudPaper>

        @* 2. Default Compiler Options & Runtime Configuration (Local Admin / Server Admin) *@
        @if (Ui.IsAuthenticated && (Ui.IsLocalSingleUser || Ui.IsAdmin))
        {
            <MudPaper Outlined="true" Class="hypera-section-card">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                    @Ui.T("settings.sectionCompiler")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    @Ui.T("settings.sectionCompilerHint")
                </MudText>

                <CompilerOptionsEditor @bind-Value="_defaultCompilerOptions"
                                       Collapsible="false"
                                       Disabled="@_savingPlatform" />

                <MudDivider Class="my-5" />

                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-3">
                    @Ui.T("settings.sectionRuntime")
                </MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int"
                                         @bind-Value="_maxUndoSteps"
                                         Label="@Ui.T("settings.maxUndoSteps")"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         Max="50" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex align-center">
                        <MudSwitch @bind-Value="_autoRollbackOnError"
                                   Color="Color.Primary"
                                   Label="@Ui.T("settings.autoRollbackOnError")" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int"
                                         @bind-Value="_maxStepsPerTurn"
                                         Label="@Ui.T("admin.maxStepsPerTurn")"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1000" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="long"
                                         @bind-Value="_maxUploadMiB"
                                         Label="@Ui.T("admin.maxUploadMb")"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="long"
                                         @bind-Value="_maxSaveQuotaMiB"
                                         Label="@Ui.T("admin.maxSaveQuotaMb")"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@_savingPlatform"
                               OnClick="@SavePlatformSettingsAsync">
                        @Ui.T("settings.saveCompilerAndRuntime")
                    </MudButton>
                </div>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private string _uiLanguage = HyperaLocalizer.DefaultLocaleCode;
    private List<string> _knownLanguages = [HyperaLocalizer.DefaultLocaleCode];
    private string? _langToAdd;
    private VersionResolutionStrategy _strategy = VersionResolutionStrategy.KnownLanguagePriority;
    private bool _savingPrefs;

    private PlatformSettings? _loadedPlatformSettings;
    private CompilerOptionsOverride? _defaultCompilerOptions;
    private int _maxUndoSteps = 5;
    private bool _autoRollbackOnError = true;
    private int _maxStepsPerTurn = PlatformSettings.DefaultMaxStepInstructionsPerTurn;
    private long _maxUploadMiB = 512;
    private long _maxSaveQuotaMiB = 64;
    private bool _savingPlatform;

    private IReadOnlyList<string> AddableLanguages =>
        Ui.AvailableLocales.Select(static l => l.Code)
            .Concat(FormatHelpers.CommonLanguageCodes)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(code => !_knownLanguages.Contains(code, StringComparer.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiChanged;
        await Ui.InitializeAsync();
        LoadFromState();
        if (Ui.IsAuthenticated && (Ui.IsLocalSingleUser || Ui.IsAdmin))
        {
            await LoadPlatformSettingsAsync();
        }
    }

    private void LoadFromState()
    {
        _uiLanguage = Ui.UiLanguage;
        if (Ui.CurrentUser is not null)
        {
            _strategy = Ui.CurrentUser.VersionStrategy;
            _knownLanguages = Ui.CurrentUser.GetKnownLanguages().ToList();
            if (_knownLanguages.Count == 0)
            {
                _knownLanguages.Add(HyperaLocalizer.DefaultLocaleCode);
            }
        }

        _langToAdd = AddableLanguages.FirstOrDefault();
    }

    private async Task LoadPlatformSettingsAsync()
    {
        try
        {
            PlatformSettings settings = await AuthService.GetSettingsAsync();
            _loadedPlatformSettings = settings;
            _defaultCompilerOptions = CompilerOptionsOverride.FromJson(settings.DefaultCompilerOptionsJson);
            _maxUndoSteps = settings.MaxUndoSteps ?? HostOptions.MaxUndoSteps;
            _autoRollbackOnError = settings.AutoRollbackOnError ?? HostOptions.AutoRollbackOnError;
            _maxStepsPerTurn = settings.MaxStepInstructionsPerTurn;
            _maxUploadMiB = Math.Max(1L, settings.MaxUploadBytes / (1024L * 1024L));
            _maxSaveQuotaMiB = Math.Max(1L, settings.MaxSaveQuotaBytesPerApp / (1024L * 1024L));
        }
        catch
        {
            // Keep defaults
        }
    }

    private async Task OnUiLanguageSelectedAsync(string code)
    {
        _uiLanguage = code;
        await Ui.SetUiLanguageAsync(code, persistToProfile: false);
    }

    private async Task OnDarkModeChangedAsync(bool isDark)
    {
        Ui.SetDarkMode(isDark);
        try
        {
            await Js.InvokeVoidAsync("hyperaPlayer.setLocalStorage", "hypera.theme", isDark ? "dark" : "light");
        }
        catch
        {
            // Ignore
        }
    }

    private void MoveLanguage(int from, int to)
    {
        if (to < 0 || to >= _knownLanguages.Count)
        {
            return;
        }

        string item = _knownLanguages[from];
        _knownLanguages.RemoveAt(from);
        _knownLanguages.Insert(to, item);
    }

    private void RemoveLanguage(int index)
    {
        if (_knownLanguages.Count <= 1 || index < 0 || index >= _knownLanguages.Count)
        {
            return;
        }

        _knownLanguages.RemoveAt(index);
        _langToAdd = AddableLanguages.FirstOrDefault();
    }

    private void AddLanguage()
    {
        if (string.IsNullOrWhiteSpace(_langToAdd))
        {
            return;
        }

        if (!_knownLanguages.Contains(_langToAdd, StringComparer.OrdinalIgnoreCase))
        {
            _knownLanguages.Add(_langToAdd);
        }

        _langToAdd = AddableLanguages.FirstOrDefault();
    }

    private async Task SavePreferencesAsync()
    {
        if (!Ui.IsAuthenticated)
        {
            return;
        }

        _savingPrefs = true;
        try
        {
            await AuthService.UpdateUserPreferencesAsync(
                Ui.CurrentUser!.Id,
                new UserPreferencesUpdate(
                    UiLanguage: _uiLanguage,
                    VersionStrategy: _strategy,
                    KnownLanguages: _knownLanguages));

            await Ui.SetUiLanguageAsync(_uiLanguage, persistToProfile: false);
            await Ui.RefreshUserAsync();
            Snackbar.Add(Ui.T("settings.saved"), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingPrefs = false;
        }
    }

    private async Task SavePlatformSettingsAsync()
    {
        if (!Ui.IsAuthenticated || !(Ui.IsLocalSingleUser || Ui.IsAdmin))
        {
            return;
        }

        _savingPlatform = true;
        try
        {
            PlatformSettings baseSettings = _loadedPlatformSettings ?? await AuthService.GetSettingsAsync();
            var updated = new PlatformSettings
            {
                Id = PlatformSettings.SingletonId,
                AllowOpenRegistration = baseSettings.AllowOpenRegistration,
                SessionIdleTimeoutMinutes = baseSettings.SessionIdleTimeoutMinutes,
                MaxUploadBytes = Math.Max(1L, _maxUploadMiB) * 1024L * 1024L,
                MaxSaveQuotaBytesPerApp = Math.Max(1L, _maxSaveQuotaMiB) * 1024L * 1024L,
                MaxStepInstructionsPerTurn = Math.Max(1000, _maxStepsPerTurn),
                DefaultCompilerOptionsJson = _defaultCompilerOptions?.ToJson(),
                MaxUndoSteps = Math.Max(0, _maxUndoSteps),
                AutoRollbackOnError = _autoRollbackOnError,
            };

            _loadedPlatformSettings = await AuthService.UpdateSettingsAsync(Ui.CurrentUser!.Id, updated);
            Snackbar.Add(Ui.T("settings.saved"), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingPlatform = false;
        }
    }

    private void OnUiChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Ui.Changed -= OnUiChanged;
}
