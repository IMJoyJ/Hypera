@inject UiSessionState Ui
@inject IAppCatalogService CatalogService
@inject IPackagePipelineService PipelineService
@inject IAuthService AuthService
@inject ILocalFilePickerService LocalPicker
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Ui.IsLocalSingleUser ? Ui.T("catalog.importGame") : Ui.T("catalog.newApp"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudTextField @bind-Value="_title"
                          Label="@Ui.T("catalog.appTitle")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true" />

            <MudTextField @bind-Value="_summary"
                          Label="@Ui.T("catalog.summary")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2" />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_versionLabel"
                                  Label="@Ui.T("catalog.initialVersion")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_languageCode"
                               Label="@Ui.T("catalog.languageCode")"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (string lang in AvailableLanguageChoices)
                        {
                            <MudSelectItem Value="@lang">@FormatHelpers.GetLanguageLabel(lang, Ui.Localizer)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (!Ui.IsLocalSingleUser)
            {
                <MudSwitch @bind-Value="_allowSourceDownload"
                           Color="Color.Primary"
                           Label="@Ui.T("catalog.allowSourceDownload")" />
            }

            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@Ui.T("catalog.importSource")</MudText>

                    @if (LocalPicker.SupportsLocalFilePick)
                    {
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FolderZip"
                                       Disabled="@_submitting"
                                       OnClick="@PickLocalFileAsync">
                                @Ui.T("catalog.pickPackageFile")
                            </MudButton>

                            @if (LocalPicker.SupportsLocalFolderPick)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.FolderOpen"
                                           Disabled="@_submitting"
                                           OnClick="@PickLocalFolderAsync">
                                    @Ui.T("catalog.pickFolder")
                                </MudButton>
                            }
                        </div>

                        @if (_localFile is not null)
                        {
                            <MudText Typo="Typo.body2" Class="hypera-mono">
                                @_localFile.FileName (@FormatHelpers.FormatBytes(_localFile.ByteSize))
                            </MudText>
                            @if (IsSelectedLocalHep)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">@Ui.T("catalog.prebuiltHepHint")</MudAlert>
                                <MudSwitch @bind-Value="_forceRecompileHep"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Label="@Ui.T("catalog.forceRecompileHep")" />
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(_localFolderPath))
                        {
                            <MudText Typo="Typo.body2" Class="hypera-mono" Style="word-break: break-all;">
                                @_localFolderPath
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Ui.T("catalog.noSourceSelected")</MudText>
                        }
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center gap-3">
                            <MudFileUpload T="IBrowserFile"
                                           Accept=".zip"
                                           FilesChanged="@OnBrowserFileSelected">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.UploadFile"
                                               Disabled="@_submitting">
                                        @Ui.T("appDetail.selectZip")
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (_browserZipFile is not null)
                            {
                                <MudText Typo="Typo.body2">@_browserZipFile.Name (@FormatHelpers.FormatBytes(_browserZipFile.Size))</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @Ui.T("appDetail.maxSize", FormatHelpers.FormatBytes(_maxUploadBytes))
                                </MudText>
                            }
                        </div>
                    }
                </MudStack>
            </MudPaper>

            <CompilerOptionsEditor @bind-Value="_compilerOptions"
                                   Collapsible="true"
                                   Disabled="@_submitting" />

            @if (_submitting)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Disabled="@_submitting">@Ui.T("app.cancel")</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@SubmitAsync"
                   Disabled="@(!CanSubmit)">
            @(Ui.IsLocalSingleUser ? Ui.T("catalog.createAndImport") : Ui.T("catalog.createAndUpload"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid UserId { get; set; }

    private string _title = string.Empty;
    private string _summary = string.Empty;
    private string _versionLabel = "v1.0";
    private string _languageCode = "ja";
    private bool _allowSourceDownload = true;
    private bool _forceRecompileHep;
    private IBrowserFile? _browserZipFile;
    private PickedLocalFile? _localFile;
    private string? _localFolderPath;
    private CompilerOptionsOverride? _compilerOptions;
    private long _maxUploadBytes = PlatformSettings.DefaultMaxUploadBytes;
    private bool _submitting;
    private string? _error;

    private bool IsSelectedLocalHep =>
        _localFile is not null
        && string.Equals(Path.GetExtension(_localFile.FileName), ".hep", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<string> AvailableLanguageChoices =>
        Ui.AvailableLocales.Select(static l => l.Code)
            .Concat(FormatHelpers.CommonLanguageCodes)
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private bool HasSelectedSource =>
        _localFile is not null
        || !string.IsNullOrWhiteSpace(_localFolderPath)
        || _browserZipFile is not null;

    private bool CanSubmit =>
        !_submitting
        && !string.IsNullOrWhiteSpace(_title)
        && !string.IsNullOrWhiteSpace(_versionLabel)
        && !string.IsNullOrWhiteSpace(_languageCode)
        && HasSelectedSource;

    protected override async Task OnInitializedAsync()
    {
        _languageCode = Ui.UiLanguage;
        try
        {
            PlatformSettings settings = await AuthService.GetSettingsAsync();
            _maxUploadBytes = settings.MaxUploadBytes;
            _compilerOptions = CompilerOptionsOverride.FromJson(settings.DefaultCompilerOptionsJson);
        }
        catch
        {
            // Keep default settings
        }
    }

    private async Task PickLocalFileAsync()
    {
        _error = null;
        try
        {
            PickedLocalFile? picked = await LocalPicker.PickPackageFileAsync();
            if (picked is null)
            {
                return;
            }

            _localFile = picked;
            _localFolderPath = null;
            _browserZipFile = null;
            _forceRecompileHep = false;
            if (string.IsNullOrWhiteSpace(_title))
            {
                _title = Path.GetFileNameWithoutExtension(picked.FileName);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PickLocalFolderAsync()
    {
        _error = null;
        try
        {
            string? folder = await LocalPicker.PickGameFolderAsync();
            if (string.IsNullOrWhiteSpace(folder))
            {
                return;
            }

            _localFolderPath = folder;
            _localFile = null;
            _browserZipFile = null;
            _forceRecompileHep = false;
            if (string.IsNullOrWhiteSpace(_title))
            {
                string trimmed = folder.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                string folderName = Path.GetFileName(trimmed);
                if (!string.IsNullOrWhiteSpace(folderName))
                {
                    _title = folderName;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnBrowserFileSelected(IBrowserFile? file)
    {
        _browserZipFile = file;
        _localFile = null;
        _localFolderPath = null;
        _error = null;
        if (file is not null && string.IsNullOrWhiteSpace(_title))
        {
            _title = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _submitting = true;
        _error = null;
        GameApp? createdApp = null;
        try
        {
            createdApp = await CatalogService.CreateAppAsync(UserId, _title.Trim(), _summary.Trim());
            GameVersion version = await CatalogService.InsertVersionAsync(
                UserId,
                createdApp.Id,
                _versionLabel.Trim(),
                string.Empty,
                VersionInsertPosition.NewestHead);

            CompilerOptionsOverride effectiveOptions = _compilerOptions ?? new CompilerOptionsOverride();
            if (_localFile is not null)
            {
                await PipelineService.SubmitLocalFileAsync(new LocalPackageFileImportRequest(
                    VersionId: version.Id,
                    LanguageCode: _languageCode.Trim(),
                    UploadedByUserId: UserId,
                    FilePath: _localFile.FullPath,
                    CompilerOptions: effectiveOptions,
                    ForceRecompile: _forceRecompileHep));
            }
            else if (!string.IsNullOrWhiteSpace(_localFolderPath))
            {
                await PipelineService.SubmitLocalDirectoryAsync(new LocalDirectoryImportRequest(
                    VersionId: version.Id,
                    LanguageCode: _languageCode.Trim(),
                    UploadedByUserId: UserId,
                    DirectoryPath: _localFolderPath,
                    CompilerOptions: effectiveOptions));
            }
            else if (_browserZipFile is not null)
            {
                await using Stream stream = _browserZipFile.OpenReadStream(_maxUploadBytes);
                await PipelineService.SubmitZipPackageAsync(new PackageUploadRequest(
                    VersionId: version.Id,
                    LanguageCode: _languageCode.Trim(),
                    UploadedByUserId: UserId,
                    AllowSourceDownload: _allowSourceDownload,
                    ZipArchiveStream: stream,
                    DeclaredByteLength: _browserZipFile.Size,
                    CompilerOptions: effectiveOptions));
            }

            Snackbar.Add(Ui.IsLocalSingleUser ? Ui.T("appDetail.imported") : Ui.T("appDetail.uploaded"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(createdApp.Id));
        }
        catch (Exception ex)
        {
            if (createdApp is not null)
            {
                try
                {
                    await CatalogService.DeleteAppAsync(UserId, createdApp.Id);
                }
                catch
                {
                    // Best-effort cleanup of empty shell app
                }
            }

            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
