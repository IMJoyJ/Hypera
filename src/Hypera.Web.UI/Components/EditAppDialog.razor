@inject UiSessionState Ui
@inject IAppCatalogService CatalogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Ui.T("appDetail.editApp")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudTextField @bind-Value="_title"
                          Label="@Ui.T("catalog.appTitle")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true" />

            <MudTextField @bind-Value="_summary"
                          Label="@Ui.T("catalog.summary")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Disabled="@_saving">@Ui.T("app.cancel")</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_saving || string.IsNullOrWhiteSpace(_title))"
                   OnClick="@SaveAsync">
            @Ui.T("app.save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public GameApp App { get; set; } = default!;

    [Parameter]
    public Guid UserId { get; set; }

    private string _title = string.Empty;
    private string _summary = string.Empty;
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        _title = App.Title;
        _summary = App.Summary;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            await CatalogService.UpdateAppMetadataAsync(
                UserId,
                App.Id,
                _title.Trim(),
                _summary.Trim(),
                isUnlistedOrDeleted: App.IsUnlistedOrDeleted);

            Snackbar.Add(Ui.T("appDetail.appUpdated"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
