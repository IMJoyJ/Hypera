@inject UiSessionState Ui
@inject IPackagePipelineService PipelineService
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Ui.T("appDetail.addVariant")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudSelect T="Guid"
                       @bind-Value="_versionId"
                       Label="@Ui.T("appDetail.launchVersion")"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (GameVersion ver in Versions)
                {
                    <MudSelectItem Value="@ver.Id">@ver.VersionLabel</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       @bind-Value="_languageCode"
                       Label="@Ui.T("catalog.languageCode")"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (string lang in AvailableLanguageChoices)
                {
                    <MudSelectItem Value="@lang">@FormatHelpers.GetLanguageLabel(lang, Ui.Localizer)</MudSelectItem>
                }
            </MudSelect>

            <MudSwitch @bind-Value="_allowSourceDownload"
                       Color="Color.Primary"
                       Label="@Ui.T("catalog.allowSourceDownload")" />

            <div class="d-flex align-center gap-3">
                <MudFileUpload T="IBrowserFile"
                               Accept=".zip"
                               FilesChanged="@OnFileSelected">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="@_submitting">
                            @Ui.T("appDetail.selectZip")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_zipFile is not null)
                {
                    <MudText Typo="Typo.body2">@_zipFile.Name (@FormatHelpers.FormatBytes(_zipFile.Size))</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Ui.T("appDetail.maxSize", FormatHelpers.FormatBytes(_maxUploadBytes))
                    </MudText>
                }
            </div>

            @if (_submitting)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Disabled="@_submitting">@Ui.T("app.cancel")</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@SubmitAsync"
                   Disabled="@(!CanSubmit)">
            @Ui.T("version.upload")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public IReadOnlyList<GameVersion> Versions { get; set; } = [];

    [Parameter]
    public Guid? DefaultVersionId { get; set; }

    [Parameter]
    public string? DefaultLanguageCode { get; set; }

    private Guid _versionId;
    private string _languageCode = "zh-CN";
    private bool _allowSourceDownload = true;
    private IBrowserFile? _zipFile;
    private long _maxUploadBytes = PlatformSettings.DefaultMaxUploadBytes;
    private bool _submitting;
    private string? _error;

    private IEnumerable<string> AvailableLanguageChoices =>
        Ui.AvailableLocales.Select(static l => l.Code)
            .Concat(FormatHelpers.CommonLanguageCodes)
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private bool CanSubmit =>
        !_submitting
        && _versionId != Guid.Empty
        && !string.IsNullOrWhiteSpace(_languageCode)
        && _zipFile is not null;

    protected override async Task OnInitializedAsync()
    {
        _versionId = DefaultVersionId ?? Versions.FirstOrDefault()?.Id ?? Guid.Empty;
        _languageCode = !string.IsNullOrWhiteSpace(DefaultLanguageCode) ? DefaultLanguageCode : Ui.UiLanguage;
        try
        {
            PlatformSettings settings = await AuthService.GetSettingsAsync();
            _maxUploadBytes = settings.MaxUploadBytes;
        }
        catch
        {
            // Keep default
        }
    }

    private void OnFileSelected(IBrowserFile? file)
    {
        _zipFile = file;
        _error = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _zipFile is null)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            await using Stream stream = _zipFile.OpenReadStream(_maxUploadBytes);
            await PipelineService.SubmitZipPackageAsync(new PackageUploadRequest(
                VersionId: _versionId,
                LanguageCode: _languageCode.Trim(),
                UploadedByUserId: UserId,
                AllowSourceDownload: _allowSourceDownload,
                ZipArchiveStream: stream,
                DeclaredByteLength: _zipFile.Size));

            Snackbar.Add(Ui.T("appDetail.uploaded"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
