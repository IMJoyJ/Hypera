@inject UiSessionState Ui
@inject IPackagePipelineService PipelineService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Ui.T("appDetail.recompileTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <div class="d-flex flex-wrap align-center gap-2">
                @if (!string.IsNullOrWhiteSpace(Submission.Version?.VersionLabel))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Submission.Version!.VersionLabel</MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @Submission.LanguageCode
                </MudChip>
            </div>

            <CompilerOptionsEditor @bind-Value="_compilerOptions"
                                   Collapsible="false"
                                   Disabled="@_submitting" />

            @if (_submitting)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Disabled="@_submitting">@Ui.T("app.cancel")</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Build"
                   Disabled="@_submitting"
                   OnClick="@SubmitAsync">
            @Ui.T("version.compile")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public GameLanguageSubmission Submission { get; set; } = default!;

    [Parameter]
    public Guid UserId { get; set; }

    private CompilerOptionsOverride? _compilerOptions;
    private bool _submitting;
    private string? _error;

    protected override void OnInitialized()
    {
        _compilerOptions = CompilerOptionsOverride.FromJson(Submission.CompilerOptionsJson);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            await PipelineService.RecompileSubmissionAsync(UserId, Submission.Id, _compilerOptions);
            Snackbar.Add(Ui.T("appDetail.recompileStarted"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
