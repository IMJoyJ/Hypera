<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Hypera.Standalone</AssemblyName>
    <RootNamespace>Hypera.Standalone</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Hypera Standalone</Product>
    <Description>Standalone Windows desktop Emuera-compatible binary runner powered by Hypera.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hypera.Core\Hypera.Core.csproj" />
    <ProjectReference Include="..\Hypera.Audio\Hypera.Audio.csproj" />
    <ProjectReference Include="..\Hypera.LegacyPluginShim\Hypera.LegacyPluginShim.csproj" />
    <ProjectReference Include="..\Hypera.Views.WinForms\Hypera.Views.WinForms.csproj" />
  </ItemGroup>
</Project>
