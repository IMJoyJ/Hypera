<Window x:Class="Hypera.Packager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hypera HEP Packager"
        Width="900"
        Height="720"
        MinWidth="720"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRootBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Meiryo UI, Microsoft YaHei UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        Drop="Window_Drop"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Language Switcher -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleText"
                               Text="Hypera HEP Packager"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Background="#232938"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadgeText"
                                   Text="v1.0.0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="AppSubtitleText"
                           Margin="0,3,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="LanguageLabelText"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangJaRadio"
                                     GroupName="LanguageGroup"
                                     Tag="ja"
                                     Content="日本語"
                                     IsChecked="True"
                                     Style="{StaticResource LanguageToggleStyle}"
                                     Checked="LanguageRadio_Checked" />
                        <RadioButton x:Name="LangZhRadio"
                                     GroupName="LanguageGroup"
                                     Tag="zh-CN"
                                     Content="简体中文"
                                     Style="{StaticResource LanguageToggleStyle}"
                                     Checked="LanguageRadio_Checked" />
                        <RadioButton x:Name="LangEnRadio"
                                     GroupName="LanguageGroup"
                                     Tag="en"
                                     Content="English"
                                     Style="{StaticResource LanguageToggleStyle}"
                                     Checked="LanguageRadio_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Drag & Drop Zone + Paths -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Border x:Name="DropZoneBorder"
                        Background="#151923"
                        BorderBrush="#334155"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="14,11"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="DropZoneTitleText"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropZoneSubtitleText"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SourceDirLabelText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="SourceDirTextBox"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,8,0"
                             TextChanged="SourceDirTextBox_TextChanged" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="2"
                            MinWidth="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseButton_Click" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="OutputPathLabelText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="OutputPathTextBox"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,8,0"
                             TextChanged="OutputPathTextBox_TextChanged" />
                    <Button x:Name="SaveAsButton"
                            Grid.Column="2"
                            MinWidth="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SaveAsButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="OptionsTitleText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="CompiledOnlyCheckBox"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,24,6" />
                    <CheckBox x:Name="CompressCheckBox"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,0,0,6" />
                </WrapPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RandomModeLabelText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="RandomModeComboBox"
                              Grid.Column="1"
                              Height="32"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectedIndex="0">
                        <ComboBoxItem x:Name="RandomFollowItem" Tag="FollowSettingJson" />
                        <ComboBoxItem x:Name="RandomOldSfmtItem" Tag="OldSfmt" />
                        <ComboBoxItem x:Name="RandomNewItem" Tag="NewRandom" />
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ExcludesLabelText"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Margin="0,7,8,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="ExcludesTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="48"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="ExcludesTextBox_TextChanged" />
                        <TextBlock x:Name="ExcludesPlaceholderText"
                                   Margin="12,8,12,0"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="PackButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="PackButton_Click" />
                <Button x:Name="OpenOutputButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="OpenOutputButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CopyDetailsButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        Click="CopyDetailsButton_Click" />
                <Button x:Name="SaveLogButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="SaveLogButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Status & Progress -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar x:Name="PackProgressBar"
                         Height="6"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Background="{StaticResource BgCardBrush}"
                         Foreground="{StaticResource AccentPrimaryBrush}"
                         BorderThickness="0"
                         Margin="0,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="9"
                         Height="9"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <!-- Scrollable Monospace Diagnostics / Log Panel -->
        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LogHeaderText"
                           Grid.Row="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="2,0,0,8" />
                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource BgLogBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderSubtleBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontFamily="Consolas, Cascadia Mono, MS Gothic, Microsoft YaHei UI"
                         FontSize="12.5"
                         TextChanged="LogTextBox_TextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
